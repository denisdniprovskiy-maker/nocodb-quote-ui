# Copy this file to .env and fill in your NocoDB API token. Never commit .env.
NOCODB_TOKEN=

# Optional overrides:
# NOCODB_URL=https://app.nocodb.com
# NOCODB_BASE_ID=pbje4jyruzt4csb
# PORT=5180
# HOST=127.0.0.1

# Payment checks: token of the webhook.site URL that receives payment confirmations
# (the part after /token/ in its API address). Without it the check button reports an error.
PAYMENT_WEBHOOK_TOKEN=
